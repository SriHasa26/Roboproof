# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=your-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Fill these after running: python scripts/list_models.py
NEBIUS_MODEL_FAST=
NEBIUS_MODEL_REASONING=
# Set to 1 only after confirming the chosen models honour response_format=json_schema (UNCONFIRMED).
NEBIUS_USE_JSON_SCHEMA=0
LLM_TIMEOUT_S=120
ROBOPROOF_DB=backend/data/roboproof.sqlite
# Development only: cache LLM responses on disk. Official recorded runs must keep this at 0.
LLM_DEV_CACHE=0
MAX_LLM_CALLS_PER_RUN=12
