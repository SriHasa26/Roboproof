# Copy to .env and fill in. Never commit .env.
NEBIUS_API_KEY=your-key-here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Fill these after running: python scripts/list_models.py
NEBIUS_MODEL_FAST=
NEBIUS_MODEL_REASONING=
# Second NVIDIA Nemotron model for the scenario generator's fallback chain (check it is a Nemotron model in list_models.py)
NEBIUS_MODEL_FALLBACK=
# Set to 1 only after confirming the chosen models honour response_format=json_schema (UNCONFIRMED).
NEBIUS_USE_JSON_SCHEMA=0
LLM_TIMEOUT_S=120
ROBOPROOF_DB=backend/data/roboproof.sqlite
# Development only: cache LLM responses on disk. Official recorded runs must keep this at 0.
LLM_DEV_CACHE=0
MAX_LLM_CALLS_PER_RUN=16

# --- live rehearsal service (placeholders only; see README "Running live") ---
# Kill switch: live runs spend real credits, so they are OFF unless this is 1.
LIVE_ENABLED=0
LIVE_DAILY_RUN_CAP=10
# Estimated spend cap per UTC day (USD), computed from run artifacts
LIVE_DAILY_USD_CAP=1.0
LIVE_RATE_PER_IP_PER_HOUR=3
# Optional shared access code; leave empty for none
LIVE_ACCESS_CODE=
# Comma-separated list of allowed frontend origins (never *), e.g. https://your-site.example
ALLOWED_ORIGINS=
LIVE_TIMEOUT_S=600
# --- small-host (single container) settings, see docs/HOSTING.md; all optional
# Alias of LIVE_TIMEOUT_S: kill a full pipeline run after this many seconds
RUN_TIMEOUT_S=600
# 0 disables ONLY the full pipeline run (scenario, sweep, batch, interpret and analyze keep working)
LIVE_PIPELINE_ENABLED=1
# Finished live-run folders kept on disk (oldest removed first)
LIVE_KEEP_RUNS=20
# Runtime data directory (live runs, daily counters, SQLite); local disk, lost when a free host spins down
DATA_DIR=/tmp/roboproof
# Port of the single-container image (the host sets it; Render uses 10000, the image defaults to 7860)
PORT=7860
# Set to 1 to run the startup self-check (simulator import + playground spec) outside host mode; it always runs in host mode
STARTUP_SELF_CHECK=0
# Host mode: small defaults (50 sweep scenarios, 50 batch rows). MAX_* override them; hard caps are 200.
ROBOPROOF_HOST_MODE=0
MAX_SWEEP_N=50
MAX_BATCH_ROWS=50

# --- playground (simulator only; no LLM spend except the optional analyze endpoint, which also needs LIVE_ENABLED=1) ---
PLAYGROUND_ENABLED=1
PLAYGROUND_RATE_SCENARIO_PER_MIN=20
PLAYGROUND_RATE_SWEEP_PER_10MIN=6
PLAYGROUND_MAX_CONCURRENT=2
PLAYGROUND_SCENARIO_TIMEOUT_S=20
PLAYGROUND_SWEEP_TIMEOUT_S=60
PLAYGROUND_MAX_SWEEP_N=200
PLAYGROUND_RATE_INTERPRET_PER_HOUR=10
